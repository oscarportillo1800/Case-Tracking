# ── Federal Litigation Tracker — Environment Variables ──────────────
#
# Copy this file to .env and fill in your values.
# The application reads these at startup via python-dotenv.

# CourtListener API token (free — get one at https://www.courtlistener.com/sign-in/)
# Without a token the API still works but is rate-limited more aggressively.
COURTLISTENER_API_TOKEN=your_token_here

# Flask secret key — change this to a long random string in production
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Port for the web server (default: 5000)
PORT=5000

# Set to "true" to enable Flask debug mode (development only)
FLASK_DEBUG=false

# Daily sync time (UTC, 24-hour format) — default is 06:00 UTC
# To change the schedule, edit backend/scheduler.py CronTrigger(hour=6, minute=0)
# SYNC_HOUR=6
# SYNC_MINUTE=0
